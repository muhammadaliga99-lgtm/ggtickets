# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Server Port (Render sets process.env.PORT automatically)
PORT=3000

# Environment: production or development
NODE_ENV=production

# Telegram IDs of Admin users (comma-separated, e.g. 123456789,987654321)
ADMIN_IDS=

# Webhook URL (leave empty for polling mode, or put your Render URL e.g. https://ggtickets.onrender.com)
WEBHOOK_URL=

# Keep-Alive Self Ping (true or false) - Keeps Render Web Service alive 24/7
KEEP_ALIVE=true

# Render External URL (Render automatically provides RENDER_EXTERNAL_URL)
RENDER_EXTERNAL_URL=
